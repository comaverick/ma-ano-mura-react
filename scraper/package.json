{
  "name": "scraper",
  "version": "1.0.0",
  "description": "Daily NCR ingredient prices and recipe coverage audits",
  "main": "index.js",
  "scripts": {
    "test": "node --test test/*.test.js",
    "sm:scrape": "node scrapeSM.js",
    "sm:filter": "node filterSM.js",
    "sm:match": "node previewSM.js",
    "sm:normalize": "node previewSM.js",
    "sm:best": "node previewSM.js",
    "sm:insert": "node insertSMPrices.js",
    "sm:insert:replace": "node insertSMPrices.js",
    "ingredients:add": "node addRecipeIngredients.js",
    "ingredients:add:dry-run": "node addRecipeIngredients.js --dry-run",
    "recipes:link": "node linkRecipeIngredients.js",
    "recipes:link:dry-run": "node linkRecipeIngredients.js --dry-run",
    "recipes:quantities": "node linkRecipeIngredients.js",
    "recipes:quantities:dry-run": "node linkRecipeIngredients.js --dry-run",
    "recipes:sync": "node syncRecipes.js",
    "recipes:sync:dry-run": "node syncRecipes.js --dry-run",
    "recipes:ingredients:export": "node exportRecipeIngredients.js",
    "sm:all": "node scrapeSM.js && node insertSMPrices.js",
    "daily": "node runDaily.js",
    "daily:dry-run": "node runDaily.js --dry-run",
    "coverage": "node auditCoverage.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@supabase/supabase-js": "^2.105.4",
    "axios": "^1.16.0",
    "cheerio": "^1.2.0",
    "dotenv": "^17.4.2",
    "node-cron": "^4.2.1",
    "puppeteer": "^24.42.0",
    "undici": "^7.30.1",
    "ws": "^8.20.0"
  },
  "engines": {
    "node": ">=22.12"
  }
}
